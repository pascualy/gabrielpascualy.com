---
import '../styles/global.css';
import { pathFor } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  date?: Date;
}
const {
  title = 'Gabriel Pascualy — Product, AI, and reliable software',
  description = 'Gabriel Pascualy. Building Ketryx and writing about AI, product, and software development.',
  article = false, date,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === pathFor();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gabriel Pascualy" />
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={pathFor('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Gabriel Pascualy's writing" href={pathFor('rss.xml')} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Gabriel Pascualy" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@gpascualy" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="site-shell">
      <aside class="identity" aria-label="About Gabriel">
        <a class="identity-link" href={pathFor()} aria-label="Gabriel Pascualy, home">
          <img src={pathFor('images/gabriel-pascualy.png')} alt="Gabriel Pascualy" width="460" height="460" class="portrait" fetchpriority="high" />
          <span class="name">Gabriel<br class="desktop-break" /> Pascualy<span class="name-period">.</span></span>
        </a>
        <p class="identity-note">Product, AI, developer tools, and how teams work.</p>
        <p class="role">Building <a href="https://www.ketryx.com/">Ketryx</a></p>
        <div class="social-links">
          <a href="https://x.com/gpascualy">Twitter / X</a>
          <a href="https://www.linkedin.com/in/gabrielpascualy/">LinkedIn</a>
          <a href="https://github.com/pascualy">GitHub</a>
        </div>
        <span class="identity-rule" aria-hidden="true"></span>
        <p class="small-note">A place for ideas,<br />observations, and working notes.</p>
      </aside>

      <div class="content-column">
        {!isHome && <header class="site-header">
          <nav aria-label="Main navigation">
            <a href={pathFor()}>Writing</a>
          </nav>
          <a class="feed-link" href={pathFor('rss.xml')}>RSS feed</a>
        </header>}
        <main id="main"><slot /></main>
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} Gabriel Pascualy</span>
          <span>Keep in touch on <a href="https://x.com/gpascualy">Twitter / X</a></span>
        </footer>
      </div>
    </div>
  </body>
</html>
