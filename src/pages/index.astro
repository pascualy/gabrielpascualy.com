---
import Base from '../layouts/Base.astro';
import { publishedPosts, pathFor, formatDate, readingMinutes } from '../lib/posts';
const posts = await publishedPosts();
---
<Base>
  <section class="introduction" aria-labelledby="intro-title">
    <p class="eyebrow">PRODUCT · AI · RELIABLE SOFTWARE</p>
    <h1 id="intro-title">Notes on building<br />things that matter.</h1>
    <p class="intro-copy">I lead product at Ketryx. Here, I write about AI, product judgment, and the decisions behind software people can rely on.</p>
  </section>

  <section class="writing-section" aria-labelledby="writing-title">
    <div class="section-heading">
      <h2 id="writing-title">Writing</h2>
      <span class="section-caption">Essays & working notes</span>
    </div>
    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <a class="post-link" href={pathFor(`writing/${post.id}/`)}>
            <div class="post-meta">
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
              <span>{post.data.type}</span>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="read-time">{readingMinutes(post.body)} min read</span>
          </a>
        </li>
      ))}
    </ol>
    {posts.length === 0 && <p class="empty-note">Essays and working notes are on the way.</p>}
  </section>

  <section class="work-note" aria-labelledby="work-title">
    <p class="eyebrow">CURRENT WORK</p>
    <h2 id="work-title">AI for regulated product development.</h2>
    <p>At Ketryx, we help teams bring AI, engineering, and quality into the same development workflow.</p>
    <a href="https://www.ketryx.com/product">Explore Ketryx</a>
  </section>
</Base>
